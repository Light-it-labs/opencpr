{
  "name": "opencpr-frontend",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Light-it-labs/opencpr.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/Light-it-labs/opencpr#readme",
  "bugs": {
    "url": "https://github.com/Light-it-labs/opencpr/issues"
  },
  "private": true,
  "type": "module",
  "config": {
    "prettier_glob": "**/*.{js,ts,tsx,css,json,md}"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "start:prod": "vite preview",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write --cache \"${npm_package_config_prettier_glob}\"",
    "format:check": "prettier --check --cache \"${npm_package_config_prettier_glob}\"",
    "type-check": "tsc --noEmit",
    "spell-check": "cspell . --no-progress --cache",
    "fixer": "pnpm lint:fix && pnpm format && pnpm type-check && pnpm spell-check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@iconify/react": "^6.0.2",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^9.41.0",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.21.0",
    "i18next": "^25.3.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-confetti-boom": "^2.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.61.1",
    "react-i18next": "^15.6.1",
    "react-scan": "^0.5.7",
    "sonner": "^2.0.6",
    "string-ts": "^2.2.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@faker-js/faker": "^10.0.0",
    "@sentry/vite-plugin": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@tanstack/eslint-plugin-router": "^1.129.7",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^4.7.0",
    "cspell": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-prefer-arrow-functions": "^3.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.7",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^5.1.0",
    "web-vitals": "^5.0.3"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "seroval": "^1.6.3",
      "seroval-plugins": "^1.6.3"
    }
  }
}
