# Optional. local, development, staging or production (default local).
# Hosted builds use production.
VITE_APP_ENV=local
# Required. The kiosk's own public origin, encoded into the registration QR.
# Phones scan it, so a hosted kiosk needs its https origin here.
VITE_PUBLIC_URL=http://localhost:5173
# Required. The API's URL including /api.
VITE_API_URL=http://localhost:8080/api
# Optional. Any value turns on React Scan when VITE_APP_ENV=local.
VITE_ENABLE_REACT_SCAN=

# Optional. Sentry; leave empty to run without it. The non-VITE_ values are
# build-time only, for source maps, and never reach the browser.
SENTRY_AUTH_TOKEN=
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# String regex without the "/". Example:
# ^https:\/\/your_server\.io\/api
VITE_SENTRY_TRACE_PROPAGATION_TARGET_REGEX=
