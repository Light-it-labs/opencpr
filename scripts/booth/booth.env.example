# Booth configuration, read by the booth scripts in scripts/booth/ubuntu/ and scripts/booth/macos/.
# Copy to ~/.config/opencpr/booth.env and set KIOSK_URL.

# Required. The kiosk's address: origin only, no path. Example: https://kiosk.example.org
KIOSK_URL=

# Optional. Board the firmware is compiled and flashed for: arduino:avr:uno or arduino:avr:mega.
# Unset, the updater detects whether an Uno or a Mega is plugged in. Set it for a clone board.
#ARDUINO_FQBN=arduino:avr:uno

# Optional. Chrome profile the kiosk runs in. Web Serial grants are stored per profile, so the board is authorized from inside this one.
#KIOSK_PROFILE="$HOME/.opencpr-kiosk-profile"

# Optional. Chrome binary; the default depends on the platform. Web Serial exists in Chrome and Edge only; snap Chromium cannot reach the serial port.
#CHROME=google-chrome                                                 # Ubuntu
#CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"   # macOS

# Optional. Serial port of the board, when auto-detection cannot identify it (clone boards) or picks the wrong one. Needs ARDUINO_FQBN.
#SERIAL_PORT=/dev/ttyACM0
