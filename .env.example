# Settings for the root docker-compose.yml, on a laptop and in production.
# Copy to .env. The values below run the laptop demo as they are; for production
# (docker-compose.prod.yml) change every value marked "production" below, as
# described in docs/hosting.md.

# Production: uncomment so every `docker compose` command uses the production
# override without repeating -f on each one.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# API. Keep APP_ENV=local while the stack is served over plain http://localhost:
# any other value marks the admin session cookie Secure and the browser drops it.
# The production override sets APP_ENV=production itself.
APP_ENV=local
# Optional. The compose files map port 8080, so leave it at 8080.
APP_PORT=8080

# Required. MySQL. docker-compose also uses MYSQL_PASSWORD as the root password;
# hosts and ports are set by docker-compose.
# Production: a long random MYSQL_PASSWORD.
MYSQL_USER=opencpr
MYSQL_PASSWORD=opencpr
MYSQL_DATABASE=opencpr

# Optional, laptop only. Host ports for MySQL and Redis (default 3306 and 6379);
# set them when a native install already owns those ports.
# MYSQL_HOST_PORT=3307
# REDIS_HOST_PORT=6380

# Email. Magic links and result emails are sent from EMAIL_FROM_ADDRESS over SMTP.
# On a laptop, docker-compose points SMTP_HOST at its local Mailpit
# (http://localhost:8025), so no email account is needed.
# Production: uncomment SMTP_HOST and set it with SMTP_PORT, SMTP_SECURE and the
# provider's SMTP_USER/SMTP_PASSWORD. Any SMTP provider works (SendGrid,
# Postmark, Amazon SES, Mailgun, your own server). SMTP_PORT defaults to 587;
# port 465 needs SMTP_SECURE=true. SMTP_USER and SMTP_PASSWORD go together.
# Required, production: an address the provider lets you send from.
EMAIL_FROM_ADDRESS=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Required. Admin sign-in: the origin the admin portal is served from, its
# registrable domain for passkeys, and the first admin created on boot.
# Production: ADMIN_APP_URL=https://admin.example.org, ADMIN_RP_ID=example.org,
# and a real mailbox for BOOTSTRAP_ADMIN_EMAIL.
ADMIN_APP_URL=http://localhost:5174
ADMIN_RP_ID=localhost
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Optional. Error reporting for the API; leave empty to run without Sentry.
SENTRY_DSN=
SENTRY_RELEASE=

# Required. Kiosk and admin portal build arguments, baked into the bundles at
# image build time, so rebuild after changing them.
# Production: VITE_API_URL=https://api.example.org/api and
# VITE_PUBLIC_URL=https://kiosk.example.org.
# VITE_APP_ENV=local turns on the admin's bundle analyzer, which keeps the build
# from finishing; the production override always builds with production.
VITE_API_URL=http://localhost:8080/api
VITE_PUBLIC_URL=http://localhost:5173
VITE_APP_NAME="OpenCPR Admin"
VITE_APP_ENV=production

# Optional. Error reporting for the kiosk and the admin portal, baked in at build
# time; leave empty to run without Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACE_PROPAGATION_TARGET_REGEX=
