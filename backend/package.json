{
  "name": "opencpr-backend",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Light-it-labs/opencpr.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/Light-it-labs/opencpr#readme",
  "bugs": {
    "url": "https://github.com/Light-it-labs/opencpr/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc && tsc-alias --resolve-full-paths",
    "postbuild": "mkdir -p dist && cp -r public dist/",
    "start:prod": "node --import ./dist/instrument.js dist/index.js",
    "dev": "tsx watch index.ts",
    "db:migrate:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --verbose --force",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "sentry:sourcemaps": "if [ -z \"$SENTRY_AUTH_TOKEN\" ]; then echo \"SENTRY_AUTH_TOKEN unset - skipping sourcemap upload\"; else sentry-cli sourcemaps inject ./dist && sentry-cli sourcemaps upload ./dist || echo \"WARNING: Sentry sourcemap upload failed - continuing deploy\"; fi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell-check": "cspell . --no-progress --cache"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@date-fns/utc": "^2.1.1",
    "@fontsource/funnel-sans": "5.3.0",
    "@fontsource/gabarito": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/node": "^11.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "@t3-oss/env-core": "^0.13.11",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "10.3.1",
    "satori": "0.63.2",
    "satori-html": "0.3.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sentry/cli": "^3.8.2",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "cspell": "^10.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "morgan": "^1.12.1",
    "prettier": "^3.9.10",
    "tsc-alias": "1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@9.14.1",
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "handlebars": ">=4.7.9",
      "basic-ftp": ">=5.3.1",
      "ip-address": ">=10.7.1",
      "ws": ">=8.21.0",
      "shell-quote": ">=1.9.0",
      "form-data": ">=4.0.6",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "fflate": "^0.7.5"
    }
  }
}
