# Optional. local, development, staging or production (default local). Anything
# but local marks the admin session cookie Secure and trusts one proxy hop;
# use production when deployed.
APP_ENV=local
# Optional (default 8080).
APP_PORT=8080

# Optional. Error reporting; unset disables it.
SENTRY_DSN=
SENTRY_RELEASE=

# Optional. Source-map upload only, read by sentry-cli during deploy, not at runtime.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Required. Database.
MYSQL_HOST=localhost
MYSQL_PORT=3306
# docker-compose also uses MYSQL_PASSWORD as the root password
MYSQL_USER=opencpr
MYSQL_PASSWORD=opencpr
MYSQL_DATABASE=opencpr

# Optional (defaults localhost and 6379).
REDIS_HOST=localhost
REDIS_PORT=6379

# Email. EMAIL_FROM_ADDRESS and SMTP_HOST are required; SMTP_PORT defaults to
# 587. These values point at the Mailpit from docker-compose (inbox at
# http://localhost:8025). Any SMTP provider works (SendGrid, Postmark, Amazon
# SES, Mailgun, your own server). SMTP_SECURE=true for port 465. SMTP_USER and
# SMTP_PASSWORD are optional but must be set together; most providers need them.
EMAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Required. Admin sign-in (magic link + passkeys).
# Origin the admin app is served from: used for magic links and as the only
# origin a passkey is accepted from
ADMIN_APP_URL=http://localhost:5174
# WebAuthn relying party id: the admin's registrable domain in production
ADMIN_RP_ID=localhost
# First portal admin, created on boot
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
