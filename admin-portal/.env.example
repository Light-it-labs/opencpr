# Required. The name shown in the portal.
VITE_APP_NAME=OpenCPR Admin
# Optional. local, development, staging or production (default local).
# local turns on the bundle analyzer, which keeps `pnpm build` from finishing;
# hosted builds use production.
VITE_APP_ENV=local
# Required. The API's URL including /api.
VITE_API_URL=http://localhost:8080/api

# Optional: leave empty to run without Sentry.
VITE_SENTRY_DSN=
# String regex without the "/". Example:
# ^https:\/\/your_server\.io\/api
VITE_SENTRY_TRACE_PROPAGATION_TARGET_REGEX=

# Optional. true shows the TanStack devtools when VITE_APP_ENV=local.
VITE_ENABLE_DEVTOOLS=

# Optional, build-time only (source-map upload), never exposed to the browser: no VITE_ prefix.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
