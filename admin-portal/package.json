    "@lukemorales/query-key-factory": "^1.3.4",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "^11.11.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.21.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@sentry/vite-plugin": "^11.11.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "baseline-browser-mapping": "^2.11.35",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-bundle-analyzer": "^1.3.9"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "seroval": "^1.6.3",
      "seroval-plugins": "^1.6.3",
      "glob@>=9.0.0 <14.0.2": "^14.0.3",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
    }
  },
  "config": {
    "prettier_glob": "**/*.{ts,tsx,css,json,md}"
  }
}
